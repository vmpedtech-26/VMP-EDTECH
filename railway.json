{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "watchPatterns": [
            "apps/api/**"
        ]
    },
    "deploy": {
        "startCommand": "cd apps/api && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE"
    }
}